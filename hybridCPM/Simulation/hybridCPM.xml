<CompuCell3D Revision="20260214" Version="4.9.0">
   
   <Metadata>
      
      <!-- Basic properties simulation -->
      <NumberOfProcessors>1</NumberOfProcessors>
      <DebugOutputFrequency>10</DebugOutputFrequency>
      <!-- <NonParallelModule Name="Potts"/> -->
      <MCSConversionFactor DisplayName="second" Units="sec">2.88</MCSConversionFactor>
      <VoxelConversionFactor DisplayName="micrometer" Units="um">0.25</VoxelConversionFactor>
   </Metadata>
   
   <Potts>
      
      <!-- Basic properties of CPM (GGH) algorithm -->
      <Dimensions x="512" y="512" z="1"/>
      <Steps>100000</Steps>
      <Temperature>10.0</Temperature>
      <NeighborOrder>2</NeighborOrder>
   </Potts>
   
   <Plugin Name="CellType">
      
      <!-- Listing all cell types in the simulation -->
      <CellType TypeId="0" TypeName="Medium"/>
      <CellType TypeId="1" TypeName="cellA"/>
   </Plugin>
   
   <Plugin Name="CenterOfMass">
      
      <!-- Module tracking center of mass of each cell -->
   </Plugin>
   
   <Plugin Name="PixelTracker">
   
   <!-- Module tracking pixels of each cell -->
   </Plugin>
   
   <Plugin Name="Volume">
      <VolumeEnergyParameters CellType="cellA" LambdaVolume="2.0" TargetVolume="5000"/>
   </Plugin>
   
   <Plugin Name="Surface">
      <SurfaceEnergyParameters CellType="cellA" LambdaSurface="2.0" TargetSurface="500"/>
   </Plugin>
   
   <Plugin Name="ExternalPotential">
      
      <!-- <External force applied to cell. Each cell type has different force.> -->
      <!-- <For more flexible specification of the constraint (done in Python) please use ExternalPotential plugin without specifying per-type parameters> -->
      <!-- <Algorithm options are: PixelBased, CenterOfMassBased> -->
      <Algorithm>CenterOfMassBased</Algorithm>
      <ExternalPotentialParameters CellType="cellA" x="5000" y="0.0" z="0.0"/>
   </Plugin>
   
   <Plugin Name="AdhesiveSat">
   
      <!-- Non-Integrin Substrate Adhesion -->
      <!-- Strength parameter 50.0-->
      <lambdaC>3.87e-13</lambdaC> 
      
      <!-- Saturation parameter (should be area of the cell)-->
      <Aref>3000.0</Aref>
      
      
      <!-- Focal adhesion penalty for breaking integrin bonds -->
      <!-- Scaling parameter (800) -->
      <LambdaFA>800.0</LambdaFA> 
      
      <!-- Initial size of an FA -->
      <N0>50.0</N0>
      
      <!-- Saturation parameter -->
      <Nh>25.0</Nh>
      
   </Plugin>
   
   <Plugin Name="NeighborTracker">
      
      <!-- Module tracking neighboring cells of each cell -->
   </Plugin>
   
   <Plugin Name="Contact">
      <!-- Specification of adhesion energies -->
      <Energy Type1="Medium" Type2="Medium">10.0</Energy>
      <Energy Type1="Medium" Type2="cellA">10.0</Energy>
      <Energy Type1="cellA" Type2="cellA">10.0</Energy>
      <NeighborOrder>2</NeighborOrder>
   </Plugin>
   
   
   
   
   <Steppable Type="UniformInitializer">
      
      <!-- Initial layout of cells in the form of rectangular slab -->
      <Region>
         <BoxMin x="390" y="206" z="0"/>
         <BoxMax x="490" y="306" z="1"/>
         <Gap>0</Gap>
         <Width>100</Width>
         <Types>cellA</Types>
      </Region>
   </Steppable>
</CompuCell3D>
